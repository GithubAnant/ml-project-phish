{
  "manifest_version": 3,
  "name": "URLSentinel",
  "version": "1.3.0",
  "icons": {
    "16": "logo.svg",
    "48": "logo.svg",
    "128": "logo.svg"
  },
  "description": "Tab badge, hover preview, page link audit (buttons/onclick), optional click guard.",
  "permissions": ["activeTab", "storage", "scripting", "contextMenus"],
  "host_permissions": ["http://127.0.0.1:8000/*", "http://localhost:8000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "URLSentinel",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "logo.svg",
      "32": "logo.svg"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": ["http://localhost:*/*", "http://127.0.0.1:*/*"],
      "js": ["heuristics.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
